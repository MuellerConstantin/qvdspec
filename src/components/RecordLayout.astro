---
/**
 * Diagram of the bit layout of an example record of the QVD index table.
 */
---

<div class="record-layout not-content" role="img" aria-label="Bit layout of an example record">
	<div class="grid">
		<div class="seg s0" style="grid-column: 1 / 5"><span class="label">Status</span><span class="range">bits 15–12</span></div>
		<div class="seg s1" style="grid-column: 5 / 10"><span class="label">Product</span><span class="range">bits 11–7</span></div>
		<div class="seg s0" style="grid-column: 10 / 17"><span class="label">Customer</span><span class="range">bits 6–0</span></div>
		<div class="bit" style="grid-column: 1">0</div>
		<div class="bit" style="grid-column: 2">0</div>
		<div class="bit" style="grid-column: 3">0</div>
		<div class="bit one" style="grid-column: 4">1</div>
		<div class="bit" style="grid-column: 5">0</div>
		<div class="bit" style="grid-column: 6">0</div>
		<div class="bit one" style="grid-column: 7">1</div>
		<div class="bit" style="grid-column: 8">0</div>
		<div class="bit one boundary" style="grid-column: 9">1</div>
		<div class="bit" style="grid-column: 10">0</div>
		<div class="bit" style="grid-column: 11">0</div>
		<div class="bit" style="grid-column: 12">0</div>
		<div class="bit" style="grid-column: 13">0</div>
		<div class="bit" style="grid-column: 14">0</div>
		<div class="bit one" style="grid-column: 15">1</div>
		<div class="bit one" style="grid-column: 16">1</div>
		<div class="byte" style="grid-column: 1 / 9">byte 1 · <code>12</code></div>
		<div class="byte" style="grid-column: 9 / 17">byte 0 · <code>83</code></div>
	</div>
	<div class="axis"><span>bit 15 (most significant)</span><span>bit 0 (least significant)</span></div>
</div>

<style>
	.record-layout {
		margin-block: 1.5rem;
		overflow-x: auto;
		font-size: var(--sl-text-xs);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(16, minmax(1.5rem, 1fr));
		min-width: 24rem;
		row-gap: 0.25rem;
	}
	.seg {
		grid-row: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-width: 0;
		padding: 0.375rem 0.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		margin-inline: 1px;
		text-align: center;
		line-height: 1.2;
	}
	.seg.s0 {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.seg.s1 {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.label {
		overflow: hidden;
		max-width: 100%;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.range {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.bit {
		grid-row: 2;
		text-align: center;
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.bit.one {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.bit.boundary {
		border-left: 1px solid var(--sl-color-gray-4);
	}
	.byte {
		grid-row: 3;
		text-align: center;
		color: var(--sl-color-gray-3);
		border-top: 1px solid var(--sl-color-gray-5);
		padding-top: 0.125rem;
	}
	.byte + .byte {
		border-left: 1px solid var(--sl-color-gray-4);
	}
	.axis {
		display: flex;
		justify-content: space-between;
		min-width: 24rem;
		margin-top: 0.25rem;
		color: var(--sl-color-gray-3);
	}
</style>
