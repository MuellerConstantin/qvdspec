---
/**
 * Diagram of the layout of a QVD file.
 */
---

<div class="file-layout not-content" role="img" aria-label="Layout of a QVD file">
	<div class="group">
		<div class="blocks">
			<div class="block">
				<div class="block-label"></div>
				<div class="rows">
					<div class="row">XML header</div>
					<div class="row marker">NUL terminator (0x00)</div>
				</div>
			</div>
		</div>
		<div class="group-label">Text</div>
	</div>

	<div class="group">
		<div class="blocks">
			<div class="block">
				<div class="block-label bracket">Symbol tables</div>
				<div class="rows">
					<div class="row">Field 1</div>
					<div class="row">Field 2</div>
					<div class="row muted">…</div>
					<div class="row">Field n</div>
				</div>
			</div>
			<div class="block">
				<div class="block-label bracket">Index table</div>
				<div class="rows">
					<div class="row">Record 1</div>
					<div class="row">Record 2</div>
					<div class="row muted">…</div>
					<div class="row">Record m</div>
				</div>
			</div>
		</div>
		<div class="group-label">Binary</div>
	</div>
</div>

<style>
	.file-layout {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 36rem;
		margin-block: 1.5rem;
		font-size: var(--sl-text-sm);
	}
	.group {
		display: grid;
		grid-template-columns: 1fr 6rem;
		gap: 0.75rem;
	}
	.blocks {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.block {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.75rem;
	}
	.rows {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	.row {
		padding: 0.5rem 0.875rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.row + .row {
		border-top: 1px solid var(--sl-color-gray-5);
	}
	.row.marker {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		padding-block: 0.25rem;
	}
	.row.muted {
		color: var(--sl-color-gray-3);
		padding-block: 0.125rem;
	}
	.block-label,
	.group-label {
		display: flex;
		align-items: center;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
	.block-label {
		justify-content: flex-end;
		text-align: right;
		padding-right: 0.75rem;
	}
	.block-label.bracket {
		border-right: 2px solid var(--sl-color-gray-4);
	}
	.group-label {
		padding-left: 0.75rem;
		border-left: 2px solid var(--sl-color-accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
</style>
